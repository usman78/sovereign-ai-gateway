# Change both keys before exposing this service beyond your own machine.
CLIENT_API_KEY=local-client-key-change-this
ADMIN_API_KEY=local-admin-key-change-this

# Keep this value stable across restarts if you want stable prompt fingerprints.
AUDIT_HMAC_KEY=replace-with-a-long-random-secret

DATABASE_PATH=./data/audit.sqlite3
GATEWAY_PROVIDER=mock
GATEWAY_MODEL=local-demo
POLICY_MODE=redact
AUDIT_CAPTURE=metadata
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
